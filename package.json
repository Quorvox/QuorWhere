{
  "name": "quorwhere",
  "version": "1.0.0",
  "description": "GeoGuessr-style game: guess the place from a street-level panorama. Solo, ranked and friend rooms (up to 5).",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node test/run.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^4.7.1",
    "pannellum": "^2.5.7",
    "pbf": "^5.1.2"
  },
  "homepage": "https://where.quorvox.ru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quorvox/QuorWhere.git"
  },
  "keywords": [
    "geoguessr",
    "game",
    "mapillary",
    "maplibre",
    "leaflet",
    "nodejs",
    "express",
    "oidc",
    "multiplayer"
  ],
  "author": "Quorvox_team",
  "private": true
}
