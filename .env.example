# Copy to .env (it is git-ignored) and fill in. See README for details.
PORT=3020
PUBLIC_URL=http://localhost:3020
NODE_ENV=development

# Street-level imagery — Mapillary (free, no credit card).
# Client token: https://www.mapillary.com/dashboard/developers → Register application → enable READ → copy "Access Token" (MLY|...)
MAPILLARY_TOKEN=

# Optional alternative: Google Street View (needs a billing account).
# Browser key (Maps JavaScript API, restrict by referrer) and server key (Street View Static API, restrict by IP).
GOOGLE_MAPS_KEY=
GOOGLE_SERVER_KEY=

# OpenID Connect login (any provider with discovery + PKCE). Redirect URI: <PUBLIC_URL>/auth/quorvox/callback
QUORVOX_ISSUER=https://id.example.com
QUORVOX_CLIENT_ID=
QUORVOX_CLIENT_SECRET=

# Comma-separated account ids (QV-xxxxxxxx or OIDC "sub") allowed to use the admin answer helper
ADMIN_QUORVOX_IDS=

# Local development only: fake logins at /auth/dev and /auth/dev?as=admin (ignored when NODE_ENV=production)
DEV_LOGIN=0

# Optional: Mapillary quality threshold (0..1) and raster fallback tiles for browsers without WebGL
# MLY_MIN_QUALITY=0.75
# TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
